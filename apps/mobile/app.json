{
  "expo": {
    "name": "Rewind V1",
    "slug": "rewind-v1",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "rewind",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Rewind to use the camera for local time-capsule captures.",
          "microphonePermission": "Allow Rewind to use the microphone for local video captures.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.rewind.v1"
    },
    "android": {
      "package": "com.rewind.v1"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
